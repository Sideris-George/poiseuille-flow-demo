import React, { useMemo, useRef } from 'react';
import { Canvas, useFrame } from '@react-three/fiber';
import { Cylinder, OrbitControls } from '@react-three/drei';

// Component for flowing RBCs/WBCs
const FlowingSphere = ({ initPosition, speed, radius, color, lengthScale, isRBC, index }) => {
  const ref = useRef();
  const [x0, y, z] = initPosition;

  useFrame((state, delta) => {
    ref.current.position.x += speed * delta;

    if (ref.current.position.x > lengthScale / 2) {
      ref.current.position.x = -lengthScale / 2 + (ref.current.position.x - lengthScale / 2);
    }

    if (isRBC) {
      ref.current.rotation.y += 0.5 * delta;
    }

    if (!isRBC) {
      ref.current.rotation.x += 0.3 * delta;
      ref.current.rotation.y += 0.3 * delta;
      const scale = radius + 0.05 * Math.sin(state.clock.elapsedTime * (index + 1));
      ref.current.scale.set(scale, scale, scale);
    }
  });

  return (
    <mesh
      ref={ref}
      position={[x0, y, z]}
      rotation={[0, Math.random() * Math.PI * 2, 0]}
      scale={isRBC ? [1, 0.5, 1] : [1, 1, 1]}
    >
      {isRBC ? (
        <sphereGeometry args={[radius, 16, 16]} />
      ) : (
        <icosahedronGeometry args={[radius, 2]} />
      )}
      <meshStandardMaterial color={color} />
    </mesh>
  );
};

const Tube = ({ radius, length, viscosity, flow, showRBCs, showWBCs }) => {
  const radiusScale = radius * 5;
  const lengthScale = length * 5;

  const rbcSpeed = flow * 2e4;
  const wbcSpeed = rbcSpeed * 0.4;

  const rbcPositions = useMemo(() => {
    if (!showRBCs) return [];
    const numRBCs = Math.round(viscosity * 20);
    return Array.from({ length: numRBCs }, () => {
      let y, z;
      do {
        y = (Math.random() - 0.5) * radiusScale * 2;
        z = (Math.random() - 0.5) * radiusScale * 2;
      } while (y * y + z * z > radiusScale * radiusScale);
      const x = (Math.random() - 0.5) * lengthScale;
      return [x, y, z];
    });
  }, [viscosity, radius, length, showRBCs]);

  const wbcPositions = useMemo(() => {
    if (!showWBCs) return [];
    const numWBCs = Math.max(1, Math.round(viscosity * 2));
    return Array.from({ length: numWBCs }, (_, i) => {
      let y, z;
      do {
        y = (Math.random() - 0.5) * radiusScale * 2;
        z = (Math.random() - 0.5) * radiusScale * 2;
      } while (y * y + z * z > radiusScale * radiusScale);
      const x = (Math.random() - 0.5) * lengthScale;
      return [x, y, z];
    });
  }, [viscosity, radius, length, showWBCs]);

  return (
    <Canvas camera={{ position: [0, 20, 50], fov: 50 }} style={{ height: 450, width: '100%' }}>
      <ambientLight intensity={0.5} />
      <spotLight position={[20, 20, 20]} />

      {/* Vessel wall */}
      <Cylinder
        args={[radiusScale * 1.05, radiusScale * 1.05, lengthScale, 32]}
        rotation={[0, 0, Math.PI / 2]}
      >
        <meshStandardMaterial color="pink" opacity={0.3} transparent />
      </Cylinder>

      {/* Blood inner volume */}
      <Cylinder args={[radiusScale, radiusScale, lengthScale * 0.98, 32]} rotation={[0, 0, Math.PI / 2]}>
        <meshStandardMaterial color="pink" opacity={0.5} transparent />
      </Cylinder>

      {/* RBCs */}
      {rbcPositions.map((pos, i) => (
        <FlowingSphere
          key={`rbc-${i}`}
          initPosition={pos}
          speed={rbcSpeed}
          radius={0.5}
          color="red"
          lengthScale={lengthScale}
          isRBC={true}
          index={i}
        />
      ))}

      {/* WBCs */}
      {wbcPositions.map((pos, i) => (
        <FlowingSphere
          key={`wbc-${i}`}
          initPosition={pos}
          speed={wbcSpeed}
          radius={0.8}
          color="green"
          lengthScale={lengthScale}
          isRBC={false}
          index={i}
        />
      ))}

      {/* Single black pericyte sitting fully outside the cylinder */}
      <mesh
        position={[0, radiusScale + 0.3, 0]} // fully above surface
        scale={[1, 0.7, 1.2]} // lumpy "mole-on-arm" shape
      >
        <sphereGeometry args={[3, 16, 16]} />
        <meshStandardMaterial color="black" />
      </mesh>

      <OrbitControls />
    </Canvas>
  );
};

export default Tube;
